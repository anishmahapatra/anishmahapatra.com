---
import { iconPaths, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d={iconPaths[name]} /></svg>
