---
import '../styles/global.css';
import SocialIcon from '../components/SocialIcon.astro';
import { socials } from '../data/socials';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Error pages: tell crawlers not to index, and skip canonical, social tags and JSON-LD. */
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const ogImageAlt = 'Anish Mahapatra, Senior AI Systems Engineer at Toast. anishmahapatra.com';

const personId = 'https://anishmahapatra.com/#person';

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Anish Mahapatra',
  url: 'https://anishmahapatra.com/',
  image: 'https://anishmahapatra.com/headshot.jpg',
  description: 'Senior MLOps Engineer and AI Educator who takes data and AI systems from prototype to production.',
  jobTitle: 'Senior MLOps Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Toast',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Liverpool John Moores University' },
    { '@type': 'CollegeOrUniversity', name: 'International Institute of Information Technology, Bangalore' },
    { '@type': 'CollegeOrUniversity', name: 'Manipal Institute of Technology' },
  ],
  sameAs: [
    'https://www.linkedin.com/in/anishmahapatra/',
    'https://github.com/anishmahapatra',
    'https://anishmahapatra.medium.com/',
    'https://x.com/_anishmahapatra',
    'https://anishmahapatra.substack.com/',
    'https://www.youtube.com/@AIForDummiesAnish',
  ],
  knowsAbout: [
    'Machine Learning Operations',
    'AIOps',
    'LLMOps',
    'Production Machine Learning',
    'Natural Language Processing',
    'Data Platforms',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://anishmahapatra.com/#website',
  url: 'https://anishmahapatra.com/',
  name: 'Anish Mahapatra',
  publisher: { '@id': personId },
};

// Both pages are about one person, so each is a ProfilePage whose mainEntity is the Person node.
const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${canonicalURL.href}#webpage`,
  url: canonicalURL.href,
  name: title,
  description,
  mainEntity: { '@id': personId },
  isPartOf: { '@id': 'https://anishmahapatra.com/#website' },
  inLanguage: 'en',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, profilePage],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />

    {!noindex && (
      <>
        <meta property="og:type" content={path === '/about/' ? 'profile' : 'website'} />
        {path === '/about/' && (
          <>
            <meta property="profile:first_name" content="Anish" />
            <meta property="profile:last_name" content="Mahapatra" />
          </>
        )}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:site_name" content="Anish Mahapatra" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        <meta name="twitter:creator" content="@_anishmahapatra" />

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton:wght@400&family=Work+Sans:wght@400;600&display=swap" rel="stylesheet" />

    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Anish Mahapatra, home">Anish Mahapatra</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#experience">Experience</a>
        <a href="/#writing">Writing</a>
        <a href="/#contact">Contact</a>
      </nav>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle light/dark theme" aria-pressed="false">
        <svg class="sun-moon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <mask id="moon-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect x="0" y="0" width="24" height="24" fill="#fff" /><circle class="moon-cut" cx="30" cy="7" r="6.5" fill="#000" /></mask>
          <g mask="url(#moon-mask)"><circle class="sun-core" cx="12" cy="12" r="5" fill="currentColor" /></g>
          <g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12.00" y1="4.00" x2="12.00" y2="1.50" /><line x1="17.66" y1="6.34" x2="19.42" y2="4.58" /><line x1="20.00" y1="12.00" x2="22.50" y2="12.00" /><line x1="17.66" y1="17.66" x2="19.42" y2="19.42" /><line x1="12.00" y1="20.00" x2="12.00" y2="22.50" /><line x1="6.34" y1="17.66" x2="4.58" y2="19.42" /><line x1="4.00" y1="12.00" x2="1.50" y2="12.00" /><line x1="6.34" y1="6.34" x2="4.58" y2="4.58" /></g>
        </svg>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-row">
        <span>&copy; {new Date().getFullYear()} Anish Mahapatra</span>
        <nav class="footer-links" aria-label="Footer">
          {socials.map((l) => (
            <a href={l.href} rel="me noopener noreferrer" target="_blank"><SocialIcon name={l.icon} /><span>{l.name}</span></a>
          ))}
          <a href="/about/">About</a>
          <a href="mailto:anishmahapatra01@gmail.com">Email</a>
          <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var effective = function () {
          return root.getAttribute('data-theme') || 'dark';
        };
        var sync = function () {
          // Pressed = dark theme on. The icon itself morphs in CSS from the theme state.
          btn.setAttribute('aria-pressed', effective() === 'dark' ? 'true' : 'false');
        };
        sync();
        btn.addEventListener('click', function () {
          var next = effective() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          sync();
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var bar = document.querySelector('.site-header');
        var set = function () { bar.classList.toggle('is-stuck', window.scrollY > 24); };
        set();
        window.addEventListener('scroll', set, { passive: true });
      })();
    </script>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
