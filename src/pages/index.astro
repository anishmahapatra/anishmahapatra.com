---
import Layout from '../layouts/Layout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import CompanyMark from '../components/CompanyMark.astro';
import { socials } from '../data/socials';
import knowledgehutSvg from '../assets/marks/knowledgehut.svg?raw';
import pepperSvg from '../assets/marks/pepper.svg?raw';

const title = 'Anish Mahapatra | Senior MLOps Engineer and AI Educator';
const description =
  'Anish Mahapatra is a Senior MLOps Engineer at Toast and an AI Educator. He takes data and AI systems to production and has taught 100,000+ learners.';

const experience = [
  {
    when: '2026–Present',
    title: 'Senior AI Systems Engineer',
    org: 'Toast',
    current: true,
    desc: 'Applying production AI/ML and data engineering experience to Toast’s restaurant fintech platform.',
  },
  {
    when: '2024–2026',
    title: 'Senior MLOps Engineer, AIOps Platform Lead',
    org: 'SAP',
    desc: 'Led productionization of an enterprise AIOps platform for Fortune 500 clients on Kubernetes; built MLOps/LLMOps workflows with GitHub Actions, ArgoCD, and MLflow, and NLP-based data anonymization pipelines.',
  },
  {
    when: '2022–2024',
    title: 'Senior AI & Machine Learning Engineer',
    org: '7-Eleven',
    desc: 'Built LLM-driven enterprise analytics with LangChain and real-time data pipelines on Kafka, Spark, and Databricks; led migration of large-scale tables to Delta Lake and Power BI.',
  },
  {
    when: '2018–2022',
    title: 'Lead Data Scientist',
    org: 'Mu Sigma',
    desc: 'Progressed from Data Scientist to Lead Data Scientist over four years, leading ML pipelines and data engineering for Fortune 300 clients across demand forecasting and anomaly detection.',
  },
];

const projects = [
  {
    name: 'Multimodal Biometric MLOps Pipeline',
    href: 'https://github.com/anishmahapatra/multimodal-fingerprint-analysis',
    flow: ['Leakage-safe split', 'Train', 'Serve · FastAPI', 'Deploy · K8s'],
    desc: 'A packaged PyTorch workflow with leakage-safe data splits, reproducible training, FastAPI serving, tests, CI, Docker, and Kubernetes manifests.',
    tags: ['PyTorch', 'FastAPI', 'Docker', 'Kubernetes'],
    status: 'Implemented',
  },
  {
    name: 'AI Engineer Interview Readiness',
    href: 'https://github.com/anishmahapatra/ai-engineer-interview-readiness',
    flow: ['Next.js UI', 'Server-side API', 'Supabase'],
    desc: 'A deployed Next.js application for AI system design and interview preparation, with a server-side contact workflow and Supabase persistence.',
    tags: ['Next.js', 'TypeScript', 'Supabase'],
    status: 'Deployed',
  },
  {
    name: 'Saathi Voice',
    href: 'https://github.com/anishmahapatra/saathi-voice',
    flow: ['Whisper', 'Claude', 'ElevenLabs', 'Latency trace'],
    desc: 'A local voice AI loop for macOS combining speech recognition, an LLM, speech synthesis, turn history, and latency tracing.',
    tags: ['Whisper', 'Claude', 'ElevenLabs'],
    status: 'Prototype',
  },
  {
    name: 'Payment Failure Intelligence Platform',
    href: 'https://github.com/anishmahapatra/payments-failure-intelligence-platform',
    flow: ['Events', 'Classify failure', 'Retry decision', 'Monitor'],
    desc: 'An architecture blueprint for payment event contracts, failure classification, retry decisions, evaluation, and production monitoring.',
    tags: ['Event-driven', 'MLOps', 'Monitoring'],
    status: 'Design phase',
  },
  {
    name: 'MultiDocument AI',
    href: 'https://github.com/anishmahapatra/MultiDocument-AI',
    flow: ['PDF · DOCX · PPTX · XLSX', 'FAISS', 'LangChain', 'Answer'],
    desc: 'A Streamlit RAG prototype for querying PDF, DOCX, PPTX, and XLSX files using FAISS and LangChain.',
    tags: ['RAG', 'LangChain', 'FAISS', 'Streamlit'],
    status: 'Prototype',
  },
];

const writing = [
  {
    title: 'Designing an End-to-End AI Platform for Payments and Retail (AWS)',
    date: 'Apr 2026',
    href: 'https://medium.com/data-science-collective/designing-an-end-to-end-ai-platform-for-payments-and-retail-aws-7fe4fce7c07e',
  },
  {
    title: 'Installing Claude Code for Agentic Engineering',
    date: 'Feb 2026',
    href: 'https://anishmahapatra.medium.com/installing-claude-code-for-agentic-engineering-dc438ab46bbf',
  },
  {
    title: 'How to Set Up an Enterprise-Ready Production Environment for Data Engineering',
    date: 'Jul 2024',
    href: 'https://medium.datadriveninvestor.com/how-to-set-up-an-enterprise-ready-production-environment-for-data-engineering-78de4829f831',
  },
  {
    title: 'What is LangChain? (AI Crash Course)',
    date: 'Feb 2024',
    href: 'https://medium.datadriveninvestor.com/what-is-langchain-ai-crash-course-4b1122793191',
  },
  {
    title: 'Build a CI/CD Pipeline on AWS',
    date: 'Nov 2023',
    href: 'https://anishmahapatra.medium.com/build-a-ci-cd-pipeline-on-aws-ebc47fb418dc',
  },
];

const stack = [
  'Python', 'PyTorch', 'FastAPI', 'Docker', 'Kubernetes', 'AWS', 'Azure', 'GCP',
  'GitHub Actions', 'Airflow', 'Kafka', 'Spark', 'Databricks', 'DynamoDB', 'SQL',
  'Splunk', 'Datadog', 'FireHydrant', 'SCONE', 'Spotify Backstage',
];

const stackTrending = [
  'LangChain', 'MLflow', 'ArgoCD', 'Terraform', 'Prometheus',
  'Grafana', 'vLLM', 'Vector Databases', 'OpenTelemetry', 'Snowflake',
];

const featured = [
  { name: 'upGrad KnowledgeHut', href: 'https://www.knowledgehut.com/' },
  { name: 'Pluralsight', href: 'https://www.pluralsight.com/' },
  { name: 'Pepper', href: 'https://www.peppercontent.io/' },
  { name: 'Towards Data Science', href: 'https://towardsdatascience.com/' },
];

// Featured & teaching logos. Every mark is the brand's own artwork, stored locally;
// `h` balances optical height across very different shapes.
type Mark =
  | { kind: 'themed'; light: string; dark: string; w: number; wDark: number; h: number }
  | { kind: 'inline'; svg: string; h: number }
  | { kind: 'icon'; icon: 'medium'; h: number }
  | { kind: 'word'; h: number };

const featuredMarks: Record<string, Mark> = {
  'upGrad KnowledgeHut': { kind: 'inline', svg: knowledgehutSvg, h: 42 },
  Pluralsight: { kind: 'themed', light: '/marks/pluralsight-light.webp', dark: '/marks/pluralsight-dark.webp', w: 504 / 86, wDark: 345 / 75, h: 32 },
  Pepper: { kind: 'inline', svg: pepperSvg, h: 34 },
  'Towards Data Science': { kind: 'themed', light: '/marks/tds-light.webp', dark: '/marks/tds-dark.webp', w: 864 / 272, wDark: 864 / 272, h: 40 },
};

const featuredWith: { name: string; href: string; mark: Mark; caption: string }[] = [
  ...featured.map((f) => ({ name: f.name, href: f.href, mark: featuredMarks[f.name], caption: 'Featured & teaching' })),
  { name: 'Medium', href: 'https://anishmahapatra.medium.com/', mark: { kind: 'icon', icon: 'medium', h: 30 }, caption: 'Top Writer' },
];

const education = [
  { name: 'MSc Data Science, Distinction (top 1%)', org: 'Liverpool John Moores University', logo: { src: '/marks/edu-ljmu.webp', lh: 32, w: 665, h: 192, mono: true } },
  { name: 'PG Diploma, Data Science', org: 'IIIT Bangalore', logo: { src: '/marks/edu-iiitb.webp', lh: 56, w: 235, h: 192, lift: true } },
  { name: 'BTech, Information Technology', org: 'Manipal Institute of Technology', logo: { src: '/marks/edu-manipal.webp', lh: 38, w: 450, h: 192 } },
];

const figures = [
  { figure: '100,000+', text: 'learners taught Data Science, Machine Learning, and AI.' },
  { figure: '9 years', text: 'taking data and AI systems from prototype to production.' },
  { figure: 'Top 1%', text: 'MSc in Data Science with Distinction, Liverpool John Moores University.' },
];

---


<Layout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="hero-role">Senior MLOps Engineer at <span class="co"><CompanyMark org="Toast" size={22} />Toast</span></p>
      <h1 id="hero-title" class="hero-name">Anish Mahapatra</h1>
      <p class="hero-lede">I take data and AI systems from prototype to production, at scale for Fortune 500 teams across fintech, adtech, and enterprise software.</p>
      <div class="hero-actions">
        <a class="button" href="#contact">Get in touch</a>
        <a class="button button-ghost" href="#work">See my work</a>
      </div>
      <nav class="hero-social" aria-label="Profiles">
        {socials.map((l) => (
          <a href={l.href} rel="me noopener noreferrer" target="_blank"><SocialIcon name={l.icon} /><span>{l.name}</span></a>
        ))}
      </nav>
    </div>
    <picture class="hero-photo">
      <source srcset="/headshot.webp" type="image/webp" />
      <img src="/headshot.jpg" alt="Portrait of Anish Mahapatra" width="1200" height="1200" fetchpriority="high" decoding="async" />
    </picture>
  </section>

  <section class="logos" aria-labelledby="logos-heading">
    <div class="logos-head" data-reveal>
      <h2 id="logos-heading" class="label">Featured &amp; teaching</h2>
    </div>
    <div class="carousel" tabindex="0" role="region" aria-label="Featured and teaching" data-reveal>
      <ul class="carousel-track">
        {featuredWith.map((c) => {
          const m = c.mark;
          const style = `--h: ${m.h}px`;
          return (
            <li class="logo-tile">
              <a class="logo-card" href={c.href} rel="noopener noreferrer" target="_blank">
                {m.kind === 'themed' ? (
                  <span class="logo-mark" style={style}>
                    <img class="only-light" src={m.light} alt={`${c.name} logo`} width={Math.round(m.h * 2 * m.w)} height={m.h * 2} loading="lazy" decoding="async" />
                    <img class="only-dark" src={m.dark} alt={`${c.name} logo`} width={Math.round(m.h * 2 * m.wDark)} height={m.h * 2} loading="lazy" decoding="async" />
                  </span>
                ) : m.kind === 'inline' ? (
                  <span class="logo-mark logo-inline" style={style} role="img" aria-label={`${c.name} logo`} set:html={m.svg} />
                ) : m.kind === 'icon' ? (
                  <span class="logo-mark logo-wordmark" style={style}><SocialIcon name={m.icon} /><span>{c.name}</span></span>
                ) : (
                  <span class="logo-mark logo-wordmark logo-wordmark-only" style={style}>{c.name}</span>
                )}
                <span class="logo-caption">{(m.kind === 'themed' || m.kind === 'inline') && <strong aria-hidden="true">{c.name}</strong>} <span>{c.caption}</span></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="about" class="section split" aria-labelledby="about-heading">
    <header class="split-head">
      <h2 id="about-heading" class="section-title" data-reveal>About</h2>
      <dl class="facts" data-reveal>
        <div><dt>Now</dt><dd><span class="co"><CompanyMark org="Toast" />Toast</span></dd></div>
        <div><dt>Role</dt><dd>Senior MLOps Engineer</dd></div>
        <div><dt>Writing</dt><dd>Medium Top Writer</dd></div>
      </dl>
    </header>
    <div class="split-body">
      <p class="lede" data-reveal>
        I'm an AI/ML engineer with several years of experience taking data and
        AI systems from prototype to production. I've built data
        infrastructure and AI/ML platforms at scale at <span class="co"><CompanyMark org="SAP" />SAP</span>, <span class="co"><CompanyMark org="7-Eleven" />7-Eleven</span>, and
        <span class="co"><CompanyMark org="Toast" />Toast</span>, working with Fortune 500 stakeholders across fintech, adtech,
        and enterprise software.
      </p>
      <div class="cols" data-reveal>
        <p>
          My work spans data engineering, machine learning, data science,
          LLM-based applications, and artificial intelligence in production:
          the full path from a working prototype to something reliable enough
          to depend on.
        </p>
        <p>
          I'm especially passionate about teaching people to be their very
          best. I believe it's better to learn than to know. I've taught
          Data Science, Machine Learning, and AI to over 100,000 learners and
          write about it on Medium, where I'm recognized as a Top Writer.
        </p>
      </div>
      <div class="record" data-reveal>
        <h3 class="label">Education</h3>
        <ul class="record-list">
          {education.map((e) => (
            <li>
              <span class="record-logo"><img class:list={[{ mono: e.logo.mono, lift: e.logo.lift }]} style={`--lh: ${e.logo.lh}px`} src={e.logo.src} width={e.logo.w} height={e.logo.h} alt="" loading="lazy" decoding="async" /></span>
              <span class="record-name">{e.name}</span><span class="soft">{e.org}</span>
            </li>
          ))}
        </ul>
      </div>
      <p data-reveal><a class="text-link" href="/about/">More about Anish Mahapatra <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section id="work" class="section field-ink work" aria-labelledby="work-heading">
    <div class="section-head" data-reveal>
      <h2 id="work-heading" class="section-title">Selected work</h2>
      <a class="text-link" href="https://github.com/anishmahapatra" rel="noopener noreferrer" target="_blank">More on GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="work-list">
      {projects.map((project) => (
        <li data-reveal>
          <a class="work-row" href={project.href} rel="noopener noreferrer" target="_blank">
            <span class="work-head">
              <span class="work-name">{project.name}</span>
              <span class="work-status">{project.status}</span>
            </span>
            <span class="work-meta">
              <span class="work-desc">{project.desc}</span>
              <span class="work-tags">{project.tags.join(' · ')}</span>
              <span class="work-flow" aria-label={`Pipeline: ${project.flow.join(', then ')}`}>
                {project.flow.map((step, i) => (<><span class="work-step" aria-hidden="true">{step}</span>{i < project.flow.length - 1 && <span class="work-sep" aria-hidden="true">→</span>}</>))}
              </span>
            </span>
            <span class="work-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="experience" class="section split" aria-labelledby="experience-heading">
    <header class="split-head">
      <h2 id="experience-heading" class="section-title" data-reveal>Experience</h2>
    </header>
    <ol class="lineup split-body">
      {experience.map((role) => (
        <li class="lineup-row" data-reveal>
          <div class="lineup-meta">
            <CompanyMark org={role.org} size={36} class="lineup-logo" />
            <h3 class="lineup-org">{role.org}</h3>
            <p class="lineup-when">{role.when}{role.current && <span class="lineup-now">Current</span>}</p>
          </div>
          <div class="lineup-role">
            <p class="lineup-title">{role.title}</p>
            <p class="lineup-desc">{role.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="stats" class="section field-accent figures" aria-labelledby="figures-heading">
    <h2 id="figures-heading" class="section-title" data-reveal>By the numbers</h2>
    <dl class="figure-list">
      {figures.map((f) => (
        <div class="figure-row" data-reveal>
          <dt>{f.figure}</dt>
          <dd>{f.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="writing" class="section split" aria-labelledby="writing-heading">
    <header class="split-head">
      <h2 id="writing-heading" class="section-title" data-reveal>Writing</h2>
      <p class="split-note" data-reveal>
        Medium Top Writer. I've taught Data Science, Machine Learning, and AI to
        over 100,000 learners.
      </p>
      <a class="text-link split-link" href="https://anishmahapatra.medium.com/" rel="noopener noreferrer" target="_blank" data-reveal>All articles on Medium <span aria-hidden="true">↗</span></a>
    </header>
    <ul class="writing-list split-body">
      {writing.map((post) => (
        <li data-reveal>
          <a class="writing-row" href={post.href} rel="noopener noreferrer" target="_blank">
            <span class="writing-title">{post.title}</span>
            <span class="writing-date">{post.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="stack" class="section split" aria-labelledby="stack-heading">
    <header class="split-head">
      <h2 id="stack-heading" class="section-title" data-reveal>Technical interests</h2>
    </header>
    <div class="split-body">
      <p class="lede" data-reveal>
        Production ML and LLM serving, evaluation and observability, Kubernetes-native
        delivery, and data contracts for real-time and batch pipelines.
      </p>
      <h3 class="label stack-label" data-reveal>Working stack</h3>
      <ul class="stack-list" data-reveal>
        {stack.map((s) => <li>{s}</li>)}
      </ul>
      <h3 class="label stack-label" data-reveal>Also exploring</h3>
      <ul class="stack-list stack-list-soft" data-reveal>
        {stackTrending.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section id="contact" class="section field-ink contact" aria-labelledby="contact-heading">
    <div class="contact-main">
      <h2 id="contact-heading" class="section-title" data-reveal>Contact</h2>
      <p class="contact-sentence" data-reveal>
        Open to conversations on AI/ML platforms, MLOps, and reliable, real-world systems.
      </p>
      <a class="contact-email" href="mailto:anishmahapatra01@gmail.com" data-reveal>anishmahapatra01@gmail.com</a>
      <button class="cta-copy" type="button" data-email="anishmahapatra01@gmail.com"><span class="cta-copy-label" aria-live="polite">Copy email</span></button>
    </div>
    <nav class="contact-links" aria-label="Social">
      {socials.map((l) => (
        <a href={l.href} rel="me noopener noreferrer" target="_blank"><SocialIcon name={l.icon} /><span class="contact-link-name">{l.name}</span><span class="contact-link-arrow" aria-hidden="true">↗</span></a>
      ))}
    </nav>
  </section>
</Layout>

<script is:inline>
  (function () {
    var btn = document.querySelector('.cta-copy');
    if (!btn) return;
    var label = btn.querySelector('.cta-copy-label');
    var defaultLabel = label.textContent;
    var timer = null;
    btn.addEventListener('click', function () {
      var email = btn.getAttribute('data-email');
      var done = function () {
        label.textContent = 'Copied';
        btn.classList.add('cta-copy-done');
        clearTimeout(timer);
        timer = setTimeout(function () {
          label.textContent = defaultLabel;
          btn.classList.remove('cta-copy-done');
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(email).then(done).catch(function () {
          window.location.href = 'mailto:' + email;
        });
      } else {
        window.location.href = 'mailto:' + email;
      }
    });
  })();

  (function () {
    // Featured & teaching: a slow, endless drift that you can also swipe. It is a real scroll container
    // (so a finger, trackpad or wheel moves it natively, momentum included) and a rAF loop nudges scrollLeft.
    // The track is cloned into several copies; the loop re-centres only while idle, so it never cuts a fling short.
    var box = document.querySelector('.carousel');
    var track = box && box.querySelector('.carousel-track');
    if (!track) return;
    var originals = Array.prototype.slice.call(track.children);
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    var SPEED = 26; // px per second
    var set = 0, pos = 0, last = 0, userAt = -1e9, touching = false, hovering = false, onScreen = true, raf = 0;
    var build = function () {
      Array.prototype.slice.call(track.querySelectorAll('[data-clone]')).forEach(function (n) { n.remove(); });
      var first = originals[0].getBoundingClientRect().left;
      var end = originals[originals.length - 1].getBoundingClientRect();
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      set = end.right + gap - first;
      var copies = Math.ceil(box.clientWidth / set) + 4;
      for (var i = 0; i < copies; i++) {
        originals.forEach(function (li) {
          var c = li.cloneNode(true);
          c.setAttribute('data-clone', '');
          c.setAttribute('aria-hidden', 'true');
          c.querySelectorAll('a').forEach(function (a) { a.tabIndex = -1; });
          track.appendChild(c);
        });
      }
      pos = box.scrollLeft = set * 2;
    };
    box.classList.add('is-marquee');
    build();
    var w = box.clientWidth;
    window.addEventListener('resize', function () { if (box.clientWidth !== w) { w = box.clientWidth; build(); } });

    // Anything that moves scrollLeft by more than our own step is the person, so we back off and take over from there.
    box.addEventListener('scroll', function () {
      if (Math.abs(box.scrollLeft - pos) > 1.5) { userAt = performance.now(); pos = box.scrollLeft; }
    }, { passive: true });
    box.addEventListener('touchstart', function () { touching = true; userAt = performance.now(); }, { passive: true });
    ['touchend', 'touchcancel'].forEach(function (t) {
      box.addEventListener(t, function () { touching = false; userAt = performance.now(); }, { passive: true });
    });
    box.addEventListener('wheel', function () { userAt = performance.now(); }, { passive: true });
    // Mouse: grab and drag like a finger. A drag that moved is not a click, so it won't open the card underneath.
    var drag = null, moved = false;
    box.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, left: box.scrollLeft }; moved = false;
    });
    window.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var dx = e.clientX - drag.x;
      if (!moved && Math.abs(dx) < 5) return;
      moved = true; box.classList.add('is-dragging');
      userAt = performance.now();
      box.scrollLeft = pos = drag.left - dx;
    });
    var drop = function () { if (!drag) return; drag = null; box.classList.remove('is-dragging'); userAt = performance.now(); };
    window.addEventListener('pointerup', drop);
    window.addEventListener('pointercancel', drop);
    box.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    box.addEventListener('dragstart', function (e) { e.preventDefault(); });
    box.addEventListener('mouseenter', function () { hovering = fine.matches; });
    box.addEventListener('mouseleave', function () { hovering = false; });
    // Tapping a card opens a new tab; on return, carry on (and drop the focus iOS leaves on the link).
    window.addEventListener('pageshow', function () {
      touching = false; hovering = false; userAt = -1e9; last = 0;
      if (document.activeElement && track.contains(document.activeElement)) document.activeElement.blur();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { onScreen = es[0].isIntersecting; if (onScreen && !raf) raf = requestAnimationFrame(tick); }).observe(box);
    }
    var tick = function (now) {
      raf = 0;
      if (!onScreen) return;
      var dt = last ? Math.min(now - last, 64) / 1000 : 0;
      last = now;
      var idle = !touching && now - userAt > 1500 && !hovering && !track.querySelector(':focus-visible');
      if (idle) {
        pos += dt * (calm.matches ? SPEED / 2 : SPEED);
        // Idle, so a jump of exactly one set is invisible: keep clear of both ends.
        if (pos >= set * 3) pos -= set;
        else if (pos <= set) pos += set;
        box.scrollLeft = pos;
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  })();

  (function () {
    // Hero: a soft accent spotlight that follows the pointer, and a slight tilt on the portrait.
    // Phones get a slow ambient drift (CSS) and, where it needs no permission, a light tilt from
    // the device's orientation. Everything stops off-screen and under reduced motion.
    var hero = document.querySelector('.hero');
    var glow = hero && hero.querySelector('.hero-glow');
    var photo = hero && hero.querySelector('.hero-photo');
    if (!hero || !glow || !photo) return;
    var calmHero = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Touch: the glow wanders on a slow looping path, driven here (not by a CSS keyframe) so Safari on
    // iPhone paints every frame. It stays on, gentler, under reduced motion: it is light, not travel.
    if (!fine) {
      var t0 = performance.now(), onScreen = true, ambient = 0;
      var amp = calmHero ? 0.5 : 1;
      var wander = function (now) {
        ambient = 0;
        if (!onScreen) return;
        var t = (now - t0) / 1000, r = hero.getBoundingClientRect();
        var x = r.width * (0.5 + 0.36 * amp * Math.sin(t * 0.32));
        var y = r.height * (0.34 + 0.24 * amp * Math.sin(t * 0.21 + 1.3));
        glow.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0)';
        ambient = requestAnimationFrame(wander);
      };
      new IntersectionObserver(function (entries) {
        onScreen = entries[0].isIntersecting;
        if (onScreen && !ambient) ambient = requestAnimationFrame(wander);
      }).observe(hero);
      ambient = requestAnimationFrame(wander);
    }
    if (calmHero) return;
    var visible = true, raf = 0;
    var gx = 0, gy = 0, tgx = 0, tgy = 0; // glow position (px within hero)
    var tx = 0, ty = 0, ttx = 0, tty = 0; // tilt, -1..1

    var rest = function () {
      var r = hero.getBoundingClientRect();
      tgx = r.width * 0.72; tgy = r.height * 0.45; ttx = 0; tty = 0;
    };
    rest(); gx = tgx; gy = tgy;

    var render = function () {
      raf = 0;
      gx += (tgx - gx) * 0.12; gy += (tgy - gy) * 0.12;
      tx += (ttx - tx) * 0.12; ty += (tty - ty) * 0.12;
      if (fine) glow.style.transform = 'translate3d(' + gx.toFixed(1) + 'px,' + gy.toFixed(1) + 'px,0)';
      photo.style.transform = Math.abs(tx) + Math.abs(ty) < 0.002 ? '' :
        'perspective(900px) rotateY(' + (tx * 4).toFixed(2) + 'deg) rotateX(' + (-ty * 4).toFixed(2) + 'deg) translate3d(' + (tx * 6).toFixed(1) + 'px,' + (ty * 6).toFixed(1) + 'px,0)';
      var moving = Math.abs(tgx - gx) > 0.5 || Math.abs(tgy - gy) > 0.5 || Math.abs(ttx - tx) > 0.002 || Math.abs(tty - ty) > 0.002;
      if (moving && visible) raf = requestAnimationFrame(render);
    };
    var kick = function () { if (!raf && visible) raf = requestAnimationFrame(render); };

    new IntersectionObserver(function (entries) {
      visible = entries[0].isIntersecting;
      hero.classList.toggle('is-offscreen', !visible);
      if (visible) kick();
    }).observe(hero);

    if (fine) {
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect();
        tgx = e.clientX - r.left; tgy = e.clientY - r.top;
        var p = photo.getBoundingClientRect();
        ttx = Math.max(-1, Math.min(1, (e.clientX - (p.left + p.width / 2)) / (r.width / 2)));
        tty = Math.max(-1, Math.min(1, (e.clientY - (p.top + p.height / 2)) / (r.height / 2)));
        kick();
      });
      hero.addEventListener('pointerleave', function () { rest(); kick(); });
      window.addEventListener('resize', function () { rest(); kick(); });
      return;
    }

    // Touch: dragging across the portrait nudges the tilt, then it settles back.
    var startX = 0, startY = 0;
    photo.addEventListener('pointerdown', function (e) { startX = e.clientX; startY = e.clientY; });
    photo.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'touch') return;
      ttx = Math.max(-1, Math.min(1, (e.clientX - startX) / 120));
      tty = Math.max(-1, Math.min(1, (e.clientY - startY) / 120));
      kick();
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (t) {
      photo.addEventListener(t, function () { ttx = 0; tty = 0; kick(); });
    });

    // Device orientation only where it is permission-free (not iOS, which needs a prompt).
    if ('DeviceOrientationEvent' in window && typeof DeviceOrientationEvent.requestPermission !== 'function') {
      window.addEventListener('deviceorientation', function (e) {
        if (e.gamma == null || e.beta == null) return;
        ttx = Math.max(-1, Math.min(1, e.gamma / 30));
        tty = Math.max(-1, Math.min(1, (e.beta - 45) / 30));
        kick();
      }, { passive: true });
    }
  })();

  (function () {
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!fine.matches) return;

    // Spotlight on the work rows follows the pointer.
    document.querySelectorAll('.work-row').forEach(function (row) {
      row.addEventListener('pointermove', function (e) {
        var r = row.getBoundingClientRect();
        row.style.setProperty('--x', (e.clientX - r.left) + 'px');
        row.style.setProperty('--y', (e.clientY - r.top) + 'px');
      });
    });

    // The hero buttons lean a few pixels toward the pointer.
    if (calm.matches) return;
    document.querySelectorAll('.hero-actions .button').forEach(function (btn) {
      btn.addEventListener('pointermove', function (e) {
        var r = btn.getBoundingClientRect();
        var dx = (e.clientX - (r.left + r.width / 2)) / r.width;
        var dy = (e.clientY - (r.top + r.height / 2)) / r.height;
        btn.style.transform = 'translate(' + (dx * 8).toFixed(1) + 'px,' + (dy * 6).toFixed(1) + 'px)';
      });
      btn.addEventListener('pointerleave', function () {
        btn.style.transform = '';
      });
    });
  })();
</script>
