---
import Layout from '../layouts/Layout.astro';

const title = 'Anish Mahapatra | Senior AI/ML Engineer, Production Systems';
const description =
  "Anish Mahapatra is an AI/ML engineer taking data and AI systems from prototype to production at Toast, previously SAP, 7-Eleven, and Mu Sigma. Medium Top Writer teaching Data Science and AI to 100,000+ learners.";

const experience = [
  {
    when: '2026–Present',
    title: 'Senior Software Engineer',
    org: 'Toast',
    logo: '/logos/toast.svg',
    logoAlt: 'Toast',
    current: true,
    desc: 'Applying production AI/ML and data engineering experience to Toast’s restaurant fintech platform.',
  },
  {
    when: '2024–2026',
    title: 'Senior MLOps Engineer, AIOps Platform Lead',
    org: 'SAP',
    logo: '/logos/sap.svg',
    logoAlt: 'SAP',
    desc: 'Led productionization of an enterprise AIOps platform for Fortune 500 clients on Kubernetes; built MLOps/LLMOps workflows with GitHub Actions, ArgoCD, and MLflow, and NLP-based data anonymization pipelines.',
  },
  {
    when: '2022–2024',
    title: 'Senior AI & Machine Learning Engineer',
    org: '7-Eleven',
    logo: '/logos/7-eleven.svg',
    logoAlt: '7-Eleven',
    desc: 'Built LLM-driven enterprise analytics with LangChain and real-time data pipelines on Kafka, Spark, and Databricks; led migration of large-scale tables to Delta Lake and Power BI.',
  },
  {
    when: '2018–2022',
    title: 'Lead Data Scientist',
    org: 'Mu Sigma',
    logo: '/logos/mu-sigma.png',
    logoAlt: 'Mu Sigma',
    desc: 'Progressed from Data Scientist to Lead Data Scientist over four years, leading ML pipelines and data engineering for Fortune 300 clients across demand forecasting and anomaly detection.',
  },
];

const projects = [
  {
    name: 'Multimodal Biometric MLOps Pipeline',
    href: 'https://github.com/anishmahapatra/multimodal-fingerprint-analysis',
    desc: 'A packaged PyTorch workflow with leakage-safe data splits, reproducible training, FastAPI serving, tests, CI, Docker, and Kubernetes manifests.',
    tags: ['PyTorch', 'FastAPI', 'Docker', 'Kubernetes'],
    status: 'Implemented',
  },
  {
    name: 'AI Engineer Interview Readiness',
    href: 'https://github.com/anishmahapatra/ai-engineer-interview-readiness',
    desc: 'A deployed Next.js application for AI system design and interview preparation, with a server-side contact workflow and Supabase persistence.',
    tags: ['Next.js', 'TypeScript', 'Supabase'],
    status: 'Deployed',
  },
  {
    name: 'Saathi Voice',
    href: 'https://github.com/anishmahapatra/saathi-voice',
    desc: 'A local voice AI loop for macOS combining speech recognition, an LLM, speech synthesis, turn history, and latency tracing.',
    tags: ['Whisper', 'Claude', 'ElevenLabs'],
    status: 'Prototype',
  },
  {
    name: 'Payment Failure Intelligence Platform',
    href: 'https://github.com/anishmahapatra/payments-failure-intelligence-platform',
    desc: 'An architecture blueprint for payment event contracts, failure classification, retry decisions, evaluation, and production monitoring.',
    tags: ['Event-driven', 'MLOps', 'Monitoring'],
    status: 'Design phase',
  },
  {
    name: 'MultiDocument AI',
    href: 'https://github.com/anishmahapatra/MultiDocument-AI',
    desc: 'A Streamlit RAG prototype for querying PDF, DOCX, PPTX, and XLSX files using FAISS and LangChain.',
    tags: ['RAG', 'LangChain', 'FAISS', 'Streamlit'],
    status: 'Prototype',
  },
];

const writing = [
  {
    title: 'Designing an End-to-End AI Platform for Payments and Retail (AWS)',
    date: 'Apr 2026',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'Installing Claude Code for Agentic Engineering',
    date: 'Feb 2026',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'How to Set Up an Enterprise-Ready Production Environment for Data Engineering',
    date: 'Jul 2024',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'What is LangChain? (AI Crash Course)',
    date: 'Feb 2024',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'Build a CI/CD Pipeline on AWS',
    date: 'Nov 2023',
    href: 'https://anishmahapatra.medium.com/',
  },
];

const stack = [
  'Python', 'PyTorch', 'FastAPI', 'Docker', 'Kubernetes', 'AWS', 'Azure', 'GCP',
  'GitHub Actions', 'Airflow', 'Kafka', 'Spark', 'Databricks', 'DynamoDB', 'SQL',
  'Splunk', 'Datadog', 'FireHydrant', 'SCONE', 'Spotify Backstage',
];

const stackTrending = [
  'LangChain', 'MLflow', 'ArgoCD', 'Terraform', 'Prometheus',
  'Grafana', 'vLLM', 'Vector Databases', 'OpenTelemetry', 'Snowflake',
];

const featured = [
  { name: 'upGrad KnowledgeHut', href: 'https://www.knowledgehut.com/blog/author/anish-mahapatra-2' },
  { name: 'Pluralsight', href: 'https://www.pluralsight.com/' },
  { name: 'Pepper', href: 'https://www.peppercontent.io/' },
  { name: 'Towards Data Science', href: 'https://towardsdatascience.com/' },
];

const education = [
  { name: 'MSc Data Science, Distinction (top 1%)', org: 'Liverpool John Moores University' },
  { name: 'PG Diploma, Data Science', org: 'IIIT Bangalore' },
  { name: 'BTech, Information Technology', org: 'Manipal Institute of Technology' },
];

const figures = [
  { figure: '100,000+', text: 'learners taught Data Science, Machine Learning, and AI.' },
  { figure: '8 years', text: 'taking data and AI systems from prototype to production, 2018 to today.' },
  { figure: '4', text: 'companies: Mu Sigma, 7-Eleven, SAP, and Toast.' },
  { figure: 'Top 1%', text: 'MSc in Data Science with Distinction, Liverpool John Moores University.' },
];

const socials = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/anishmahapatra/' },
  { name: 'GitHub', href: 'https://github.com/anishmahapatra' },
  { name: 'Medium', href: 'https://anishmahapatra.medium.com/' },
  { name: 'Twitter', href: 'https://x.com/_anishmahapatra' },
];
---

<Layout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-sentence-sm">I take data and AI systems from prototype to production, at scale for Fortune 500 teams across fintech, adtech, and enterprise software.</p>
    <h1 id="hero-title" class="monument">
      <span class="mask"><span class="mask-in"><span class="monument-word">Anish</span><picture class="monument-photo"><source srcset="/headshot.webp" type="image/webp" /><img src="/headshot.jpg" alt="Portrait of Anish Mahapatra" width="640" height="640" /></picture><span class="hero-sentence">I take data and AI systems from prototype to production, at scale for Fortune 500 teams across fintech, adtech, and enterprise software.</span></span></span>
      <span class="mask"><span class="mask-in mask-in-2">Mahapatra</span></span>
    </h1>
    <div class="hero-foot">
      <p class="hero-role">Senior AI/ML Engineer, Production Systems</p>
      <a class="button" href="#contact">Say hello</a>
    </div>
  </section>

  <section id="about" class="about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="section-title" data-reveal>About</h2>
    <dl class="facts" data-reveal>
      <div><dt>Now</dt><dd>Toast</dd></div>
      <div><dt>Role</dt><dd>Senior AI/ML Engineer</dd></div>
      <div><dt>Writing</dt><dd>Medium Top Writer</dd></div>
    </dl>
    <div class="about-body">
      <p class="about-lede" data-reveal>
        I'm an AI/ML engineer with several years of experience taking data and
        AI systems from prototype to production. I've built data
        infrastructure and AI/ML platforms at scale at SAP, 7-Eleven, and
        Toast, working with Fortune 500 stakeholders across fintech, adtech,
        and enterprise software.
      </p>
      <div class="about-cols" data-reveal>
        <p>
          My work spans data engineering, machine learning, data science,
          LLM-based applications, and artificial intelligence in production:
          the full path from a working prototype to something reliable enough
          to depend on.
        </p>
        <p>
          I'm especially passionate about teaching people to be their very
          best. I believe it's better to learn than to know. I've taught
          Data Science, Machine Learning, and AI to over 100,000 learners and
          write about it on Medium, where I'm recognized as a Top Writer.
        </p>
      </div>
    </div>
    <p class="record-word" data-reveal>Education</p>
    <div class="record" data-reveal>
      <ul class="record-list">
        {education.map((e) => (
          <li><span>{e.name}</span><span class="soft">{e.org}</span></li>
        ))}
      </ul>
      <div>
        <p class="record-sub">Featured &amp; teaching</p>
        <ul class="record-list">
          {featured.map((f) => (
            <li><a class="text-link" href={f.href} rel="noopener noreferrer" target="_blank">{f.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="work" class="work field-ink" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-title" data-reveal>Selected work</h2>
    <ul class="work-list">
      {projects.map((project) => (
        <li data-reveal>
          <a class="work-row" href={project.href} rel="noopener noreferrer" target="_blank">
            <span class="work-name">{project.name}</span>
            <span class="work-meta">
              <span class="work-desc">{project.desc}</span>
              <span class="work-tags">{project.status} · {project.tags.join(' · ')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="experience" class="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title" data-reveal>Experience</h2>
    <ul class="lineup">
      {experience.map((role) => (
        <li class="lineup-row" data-reveal>
          <span class="lineup-org">{role.org}{role.current && <span class="lineup-now"> · Current</span>}</span>
          <span class="lineup-title">{role.title}</span>
          <span class="lineup-desc">{role.desc}</span>
          <span class="lineup-when">{role.when}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="stats" class="figures field-accent" aria-labelledby="figures-heading">
    <h2 id="figures-heading" class="section-title" data-reveal>By the numbers</h2>
    <dl class="figure-list">
      {figures.map((f) => (
        <div class="figure-row" data-reveal>
          <dt>{f.figure}</dt>
          <dd>{f.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="writing" class="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading" class="section-title" data-reveal>Writing</h2>
    <p class="writing-lede" data-reveal>
      Medium Top Writer. I've taught Data Science, Machine Learning, and AI to
      over 100,000 learners.
    </p>
    <ul class="writing-list">
      {writing.map((post) => (
        <li data-reveal>
          <a class="writing-row" href={post.href} rel="noopener noreferrer" target="_blank">
            <span>{post.title}</span>
            <span class="writing-date">{post.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="stack" class="stack" aria-labelledby="stack-heading">
    <h2 id="stack-heading" class="section-title" data-reveal>Technical interests</h2>
    <p class="stack-lede" data-reveal>
      Production ML and LLM serving, evaluation and observability, Kubernetes-native
      delivery, and data contracts for real-time and batch pipelines.
    </p>
    <p class="stack-list" data-reveal>{stack.join(', ')}.</p>
    <p class="stack-sub" data-reveal>Also exploring: {stackTrending.join(', ')}.</p>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="contact-sentence" data-reveal>
      Open to conversations on AI/ML platforms, MLOps, and reliable, real-world systems.
    </h2>
    <a class="contact-email" href="mailto:anishmahapatra01@gmail.com" data-reveal>anishmahapatra01@<br />gmail.com</a>
    <div class="contact-foot">
      <button class="cta-copy" type="button" data-email="anishmahapatra01@gmail.com"><span class="cta-copy-label">Copy email</span></button>
      <nav class="contact-links" aria-label="Social">
        {socials.map((l) => (
          <a href={l.href} rel="me noopener noreferrer" target="_blank">{l.name}</a>
        ))}
      </nav>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var btn = document.querySelector('.cta-copy');
    if (!btn) return;
    var label = btn.querySelector('.cta-copy-label');
    var defaultLabel = label.textContent;
    var timer = null;
    btn.addEventListener('click', function () {
      var email = btn.getAttribute('data-email');
      var done = function () {
        label.textContent = 'Copied';
        btn.classList.add('cta-copy-done');
        clearTimeout(timer);
        timer = setTimeout(function () {
          label.textContent = defaultLabel;
          btn.classList.remove('cta-copy-done');
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(email).then(done).catch(function () {
          window.location.href = 'mailto:' + email;
        });
      } else {
        window.location.href = 'mailto:' + email;
      }
    });
  })();
</script>
