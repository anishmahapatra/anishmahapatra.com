---
import Layout from '../layouts/Layout.astro';
import linkedinIcon from '../icons/linkedin.svg?raw';
import githubIcon from '../icons/github.svg?raw';
import mediumIcon from '../icons/medium.svg?raw';
import xIcon from '../icons/x.svg?raw';
import tdsIcon from '../icons/towards-data-science.svg?raw';
import knowledgehutIcon from '../icons/knowledgehut.svg?raw';
import pepperIcon from '../icons/pepper.svg?raw';

const title = 'Anish Mahapatra | Senior AI/ML Engineer, Production Systems';
const description =
  "Anish Mahapatra is an AI/ML engineer taking data and AI systems from prototype to production at Toast, previously SAP, 7-Eleven, and Mu Sigma. Medium Top Writer teaching Data Science and AI to 100,000+ learners.";

const experience = [
  {
    when: '2026–Present',
    title: 'Senior Software Engineer',
    org: 'Toast',
    logo: '/logos/toast.svg',
    logoAlt: 'Toast',
    current: true,
    desc: 'Applying production AI/ML and data engineering experience to Toast’s restaurant fintech platform.',
  },
  {
    when: '2024–2026',
    title: 'Senior MLOps Engineer, AIOps Platform Lead',
    org: 'SAP',
    logo: '/logos/sap.svg',
    logoAlt: 'SAP',
    desc: 'Led productionization of an enterprise AIOps platform for Fortune 500 clients on Kubernetes; built MLOps/LLMOps workflows with GitHub Actions, ArgoCD, and MLflow, and NLP-based data anonymization pipelines.',
  },
  {
    when: '2022–2024',
    title: 'Senior AI & Machine Learning Engineer',
    org: '7-Eleven',
    logo: '/logos/7-eleven.svg',
    logoAlt: '7-Eleven',
    desc: 'Built LLM-driven enterprise analytics with LangChain and real-time data pipelines on Kafka, Spark, and Databricks; led migration of large-scale tables to Delta Lake and Power BI.',
  },
  {
    when: '2018–2022',
    title: 'Lead Data Scientist',
    org: 'Mu Sigma',
    logo: '/logos/mu-sigma.png',
    logoAlt: 'Mu Sigma',
    desc: 'Progressed from Data Scientist to Lead Data Scientist over four years, leading ML pipelines and data engineering for Fortune 300 clients across demand forecasting and anomaly detection.',
  },
];

const projects = [
  {
    name: 'Multimodal Biometric MLOps Pipeline',
    href: 'https://github.com/anishmahapatra/multimodal-fingerprint-analysis',
    desc: 'A packaged PyTorch workflow with leakage-safe data splits, reproducible training, FastAPI serving, tests, CI, Docker, and Kubernetes manifests.',
    tags: ['PyTorch', 'FastAPI', 'Docker', 'Kubernetes'],
    status: 'Implemented',
  },
  {
    name: 'AI Engineer Interview Readiness',
    href: 'https://github.com/anishmahapatra/ai-engineer-interview-readiness',
    desc: 'A deployed Next.js application for AI system design and interview preparation, with a server-side contact workflow and Supabase persistence.',
    tags: ['Next.js', 'TypeScript', 'Supabase'],
    status: 'Deployed',
  },
  {
    name: 'Saathi Voice',
    href: 'https://github.com/anishmahapatra/saathi-voice',
    desc: 'A local voice AI loop for macOS combining speech recognition, an LLM, speech synthesis, turn history, and latency tracing.',
    tags: ['Whisper', 'Claude', 'ElevenLabs'],
    status: 'Prototype',
  },
  {
    name: 'Payment Failure Intelligence Platform',
    href: 'https://github.com/anishmahapatra/payments-failure-intelligence-platform',
    desc: 'An architecture blueprint for payment event contracts, failure classification, retry decisions, evaluation, and production monitoring.',
    tags: ['Event-driven', 'MLOps', 'Monitoring'],
    status: 'Design phase',
  },
  {
    name: 'MultiDocument AI',
    href: 'https://github.com/anishmahapatra/MultiDocument-AI',
    desc: 'A Streamlit RAG prototype for querying PDF, DOCX, PPTX, and XLSX files using FAISS and LangChain.',
    tags: ['RAG', 'LangChain', 'FAISS', 'Streamlit'],
    status: 'Prototype',
  },
];

const writing = [
  {
    title: 'Designing an End-to-End AI Platform for Payments and Retail (AWS)',
    date: 'Apr 2026',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'Installing Claude Code for Agentic Engineering',
    date: 'Feb 2026',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'How to Set Up an Enterprise-Ready Production Environment for Data Engineering',
    date: 'Jul 2024',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'What is LangChain? (AI Crash Course)',
    date: 'Feb 2024',
    href: 'https://anishmahapatra.medium.com/',
  },
  {
    title: 'Build a CI/CD Pipeline on AWS',
    date: 'Nov 2023',
    href: 'https://anishmahapatra.medium.com/',
  },
];

const stack = [
  'Python', 'PyTorch', 'FastAPI', 'Docker', 'Kubernetes', 'AWS', 'Azure', 'GCP',
  'GitHub Actions', 'Airflow', 'Kafka', 'Spark', 'Databricks', 'DynamoDB', 'SQL',
  'Splunk', 'Datadog', 'FireHydrant', 'SCONE', 'Spotify Backstage',
];

const stackTrending = [
  'LangChain', 'MLflow', 'ArgoCD', 'Terraform', 'Prometheus',
  'Grafana', 'vLLM', 'Vector Databases', 'OpenTelemetry', 'Snowflake',
];

const featured = [
  { name: 'upGrad KnowledgeHut', inline: knowledgehutIcon, slug: 'knowledgehut', href: 'https://www.knowledgehut.com/blog/author/anish-mahapatra-2' },
  { name: 'Pluralsight', imgLight: '/logos/pluralsight-color-fill.png', imgDark: '/logos/pluralsight-color.png', href: 'https://www.pluralsight.com/' },
  { name: 'Pepper', inline: pepperIcon, slug: 'pepper', href: 'https://www.peppercontent.io/' },
  { name: 'Towards Data Science', inline: tdsIcon, slug: 'tds', href: 'https://towardsdatascience.com/' },
];
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow">Senior AI/ML Engineer · Production Systems</p>
        <h1>Anish Mahapatra</h1>
        <p class="lede">
          I take data and AI systems from prototype to production, building
          platforms and infrastructure at scale for Fortune 500 teams across
          fintech, adtech, and enterprise software.
        </p>
        <div class="hero-links">
          <a class="pill" href="https://www.linkedin.com/in/anishmahapatra/" rel="me noopener noreferrer" target="_blank">
            <span class="pill-icon" aria-hidden="true" set:html={linkedinIcon} />
            LinkedIn
          </a>
          <a class="pill" href="https://github.com/anishmahapatra" rel="me noopener noreferrer" target="_blank">
            <span class="pill-icon" aria-hidden="true" set:html={githubIcon} />
            GitHub
          </a>
          <a class="pill" href="https://anishmahapatra.medium.com/" rel="me noopener noreferrer" target="_blank">
            <span class="pill-icon" aria-hidden="true" set:html={mediumIcon} />
            Medium
          </a>
          <a class="pill" href="https://x.com/_anishmahapatra" rel="me noopener noreferrer" target="_blank">
            <span class="pill-icon" aria-hidden="true" set:html={xIcon} />
            Twitter
          </a>
        </div>
      </div>
      <div class="hero-photo">
        <picture>
          <source srcset="/headshot.webp" type="image/webp" />
          <img src="/headshot.jpg" alt="Portrait of Anish Mahapatra" width="272" height="272" />
        </picture>
      </div>
    </div>
  </section>

  <section id="about" aria-labelledby="about-heading">
    <div class="wrap">
      <h2 id="about-heading">About</h2>
      <div class="prose">
        <p>
          I'm an AI/ML engineer with several years of experience taking data
          and AI systems from prototype to production. I've built data
          infrastructure and AI/ML platforms at scale at SAP, 7-Eleven, and
          Toast, working with Fortune 500 stakeholders across fintech, adtech,
          and enterprise software.
        </p>
        <p>
          My work spans data engineering, machine learning, data science,
          LLM-based applications, and artificial intelligence in production:
          the full path from a working prototype to something reliable enough
          to depend on.
        </p>
        <p>
          I'm especially passionate about teaching people to be their very
          best. I believe it's better to learn than to know. I've taught
          Data Science, Machine Learning, and AI to over 100,000 learners and
          write about it on Medium, where I'm recognized as a Top Writer.
        </p>
        <p>
          MSc in Data Science with Distinction (top 1%) from Liverpool John
          Moores University, a postgraduate diploma in Data Science from IIIT
          Bangalore, and a BTech in Information Technology from Manipal
          Institute of Technology.
        </p>
      </div>
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-heading">
    <div class="wrap">
      <h2 id="experience-heading">Experience</h2>
      <ul class="timeline">
        {experience.map((role) => (
          <li class={`role ${role.current ? 'role-current' : ''}`}>
            <span class="role-when">{role.when}</span>
            <div>
              <div class="role-heading">
                <img class="role-logo" src={role.logo} alt={role.logoAlt} loading="lazy" />
                <p class="role-title">{role.title} · <span class="role-org">{role.org}</span></p>
                {role.current && (
                  <span class="current-indicator">
                    <span class="current-dot" aria-hidden="true" />
                    Current
                  </span>
                )}
              </div>
              <p class="role-desc">{role.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="stack" aria-labelledby="stack-heading">
    <div class="wrap">
      <h2 id="stack-heading">Technical interests</h2>
      <p class="lede" style="margin-bottom:1.25rem;">
        Production ML and LLM serving, evaluation and observability, Kubernetes-native
        delivery, and data contracts for real-time and batch pipelines.
      </p>
      <div class="stack-row">
        {stack.map((item) => <span class="tag">{item}</span>)}
      </div>
      <p class="stack-sublabel">Also exploring</p>
      <div class="stack-row">
        {stackTrending.map((item) => <span class="tag tag-trending">{item}</span>)}
      </div>
    </div>
  </section>

  <section id="writing" aria-labelledby="writing-heading">
    <div class="wrap">
      <h2 id="writing-heading">
        <span class="heading-icon" aria-hidden="true" set:html={mediumIcon} />
        Writing
      </h2>
      <p class="lede" style="margin-bottom:1.25rem;">
        Medium Top Writer. I've taught Data Science, Machine Learning, and AI
        to over 100,000 learners.
      </p>
      <ul class="writing-list">
        {writing.map((post) => (
          <li class="writing-item">
            <a href={post.href} rel="noopener noreferrer" target="_blank">
              <span class="writing-title">{post.title}</span>
              <span class="writing-date">{post.date}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="featured" aria-labelledby="featured-heading">
    <div class="wrap">
      <h2 id="featured-heading">Featured &amp; Teaching</h2>
      <div class="marquee">
        <div class="marquee-track">
          {[...featured, ...featured].map((f) => (
            f.inline ? (
              <a
                class={`marquee-item ${f.slug ? `logo-${f.slug}` : ''}`}
                href={f.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={f.name}
                set:html={f.inline}
              />
            ) : f.imgLight ? (
              <a
                class="marquee-item"
                href={f.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={f.name}
              >
                <img class="theme-img-light" src={f.imgLight} alt={f.name} loading="lazy" />
                <img class="theme-img-dark" src={f.imgDark} alt={f.name} loading="lazy" />
              </a>
            ) : (
              <a
                class="marquee-item"
                href={f.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={f.name}
              >
                <img src={f.img} alt={f.name} loading="lazy" />
              </a>
            )
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="work-heading">
    <div class="wrap">
      <h2 id="work-heading">
        <span class="heading-icon" aria-hidden="true" set:html={githubIcon} />
        Selected work
      </h2>
      <div class="projects">
        {projects.map((project) => (
          <a class="project" href={project.href} rel="noopener noreferrer" target="_blank">
            <div class="project-top">
              <span class="project-name">{project.name}</span>
              <span class="project-status">{project.status}</span>
            </div>
            <p class="project-desc">{project.desc}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="cta-band" aria-labelledby="contact-heading">
    <div class="cta-shapes" aria-hidden="true"></div>
    <div class="wrap cta-inner">
      <h2 id="contact-heading">Let&rsquo;s build something worth production.</h2>
      <p class="cta-lede">
        Open to conversations on AI/ML platforms, MLOps, and anything at the
        intersection of research and reliable, real-world systems.
      </p>
      <div class="cta-actions">
        <a class="cta-primary" href="mailto:anishmahapatra01@gmail.com">
          Say hello
          <span class="cta-primary-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <button class="cta-copy" type="button" data-email="anishmahapatra01@gmail.com">
          <svg class="cta-copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="8" y="8" width="13" height="13" rx="2" stroke="currentColor" stroke-width="2" />
            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="2" />
          </svg>
          <span class="cta-copy-label">Copy email</span>
        </button>
      </div>
      <div class="cta-links">
        <a class="cta-pill" href="https://www.linkedin.com/in/anishmahapatra/" rel="me noopener noreferrer" target="_blank">
          <span class="pill-icon" aria-hidden="true" set:html={linkedinIcon} />
          LinkedIn
        </a>
        <a class="cta-pill" href="https://github.com/anishmahapatra" rel="me noopener noreferrer" target="_blank">
          <span class="pill-icon" aria-hidden="true" set:html={githubIcon} />
          GitHub
        </a>
        <a class="cta-pill" href="https://anishmahapatra.medium.com/" rel="me noopener noreferrer" target="_blank">
          <span class="pill-icon" aria-hidden="true" set:html={mediumIcon} />
          Medium
        </a>
        <a class="cta-pill" href="https://x.com/_anishmahapatra" rel="me noopener noreferrer" target="_blank">
          <span class="pill-icon" aria-hidden="true" set:html={xIcon} />
          Twitter
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var btn = document.querySelector('.cta-copy');
    if (!btn) return;
    var label = btn.querySelector('.cta-copy-label');
    var defaultLabel = label.textContent;
    var timer = null;
    btn.addEventListener('click', function () {
      var email = btn.getAttribute('data-email');
      var done = function () {
        label.textContent = 'Copied';
        btn.classList.add('cta-copy-done');
        clearTimeout(timer);
        timer = setTimeout(function () {
          label.textContent = defaultLabel;
          btn.classList.remove('cta-copy-done');
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(email).then(done).catch(function () {
          window.location.href = 'mailto:' + email;
        });
      } else {
        window.location.href = 'mailto:' + email;
      }
    });
  })();
</script>
