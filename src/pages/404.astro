---
import Layout from '../layouts/Layout.astro';

const title = 'Page not found | Anish Mahapatra';
const description = 'This page could not be found.';
---

<Layout title={title} description={description} path="/404/" noindex>
  <section class="not-found">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede">
        That page doesn't exist. Head back to the
        <a class="text-link" href="/">homepage</a>.
      </p>
    </div>
  </section>
</Layout>
